    },
    {
      "id": "NEG-SEPARATOR-BYPASS-012",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "provider_response": {}, "raw-provider-payload": {}, "vendor-output": {}, "reasoning_content": "private" } },
      "expectedCodes": ["hiddenReasoning", "rawProviderPayload"]
