    {
      "id": "NEG-DATA-URI-VARIANTS-013",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": [" data:text/plain;base64,c2VjcmV0", "prefix data:image/png;charset=utf-8;base64,AAAA", "data:application/octet-stream;base64,_-_-_"] },
