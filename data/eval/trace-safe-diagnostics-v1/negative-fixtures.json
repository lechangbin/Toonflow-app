  "cases": [
    {
      "id": "NEG-CREDENTIAL-001",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "authorization": "Bearer fixture-secret-value" } },
      "expectedCodes": ["secretValue", "sensitiveKey"]
    },
    {
      "id": "NEG-BASE64-002",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "image": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
      "expectedCodes": ["base64Payload"]
    },
    {
      "id": "NEG-SIGNED-URL-003",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "url": "https://fixture.invalid/object?X-Amz-Signature=fake&X-Amz-Expires=60" } },
      "expectedCodes": ["signedUrl"]
    },
    {
      "id": "NEG-PROVIDER-PAYLOAD-004",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "vendorResponse": { "status": "failed", "unknown": true } } },
      "expectedCodes": ["rawProviderPayload"]
    },
    {
      "id": "NEG-REASONING-005",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "hiddenReasoning": "fixture private reasoning" } },
      "expectedCodes": ["hiddenReasoning"]
    },
    {
      "id": "NEG-UNKNOWN-FIELD-006",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": {}, "vendorDebugBlob": { "status": "raw" } },
      "expectedCodes": ["unknownField"]
    },
    {
      "id": "NEG-NESTED-ARRAY-007",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": [{ "safe": "request-1" }, { "password": "fixture-password-value" }] },
      "expectedCodes": ["sensitiveKey"]
    },
    {
      "id": "NEG-DATA-URI-008",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": { "image": "data:image/png;base64,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
      "expectedCodes": ["base64Payload"]
    },
    {
      "id": "NEG-COMMON-TOKENS-009",
      "allowedTopLevelKeys": ["evidence"],
      "input": { "evidence": ["npm_abcdefghijklmnopqrstuvwxyz123456", "ghp_abcdefghijklmnopqrstuvwxyz123456", "AKIA1234567890ABCDEF"] },
      "expectedCodes": ["secretValue"]
    },
    {
      "id": "NEG-JWT-SK-010",
      "allowedTopLevelKeys": ["evidence"],
